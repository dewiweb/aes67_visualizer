{
  "name": "aes67-visualizer",
  "version": "1.5.9",
  "description": "AES67/ST2110-30/RAVENNA Audio-over-IP Stream Visualizer",
  "author": "AES67 Vizu",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "dev:app": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:mac": "npm run build && electron-builder --mac",
    "build:all": "npm run build && electron-builder --win --linux",
    "generate-icons": "node scripts/generate-icons.cjs",
    "lint": "eslint src --ext .ts,.tsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@rolldown/binding-win32-x64-msvc": "^1.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "audify": "^1.9.0",
    "bonjour-service": "^1.4.4",
    "dnssd": "^0.4.1",
    "electron-store": "^8.2.0",
    "lucide-react": "^1.31.0",
    "multicast-dns": "^7.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sdp-transform": "^3.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sdp-transform": "^3.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.aes67.visualizer",
    "productName": "AES67 Visualizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/audify/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Audio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
